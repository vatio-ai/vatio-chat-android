<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the settings and the SDK's stored conversation off cloud
     backups and device-to-device transfers, as allowBackup="false" does on
     older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
